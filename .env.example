# Docker Compose host ports.
FTKV_NODE1_PORT=50051
FTKV_NODE2_PORT=50052
FTKV_NODE3_PORT=50053

# Raft timing defaults keep node 1 as the preferred first election candidate.
FTKV_HEARTBEAT_INTERVAL_MS=100
FTKV_NODE1_ELECTION_TIMEOUT_MIN_MS=300
FTKV_NODE1_ELECTION_TIMEOUT_MAX_MS=400
FTKV_NODE2_ELECTION_TIMEOUT_MIN_MS=700
FTKV_NODE2_ELECTION_TIMEOUT_MAX_MS=850
FTKV_NODE3_ELECTION_TIMEOUT_MIN_MS=1100
FTKV_NODE3_ELECTION_TIMEOUT_MAX_MS=1250
